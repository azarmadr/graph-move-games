{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "rustup-init": "rustup toolchain install 1.88.0 --target wasm32-unknown-unknown",
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "build-wasm": "node scripts/build-wasm.mjs",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && tsc -p tsconfig.json --noEmit"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "^26.4.0",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@types/dagre": "^0.7.54",
    "force-graph": "^1.51.4"
  }
}
